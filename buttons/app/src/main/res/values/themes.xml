<resources>
    <style name="Theme.Buttons" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="Section">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- A full-width button, 56dp tall: easy to tap. The styles below change only the look. -->
    <style name="WideButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="WideButton.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="WideButton.Elevated" parent="Widget.Material3.Button.ElevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="WideButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="WideButton.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- One third of the toggle group. -->
    <style name="ToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
