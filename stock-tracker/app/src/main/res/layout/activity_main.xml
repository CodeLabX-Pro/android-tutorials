<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/title"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- Symbol box and Track button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/inputSymbol"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/tile"
            android:hint="@string/hint_symbol"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters"
            android:maxLines="1"
            android:paddingHorizontal="18dp"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTrack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minHeight="56dp"
            android:text="@string/track"
            android:textSize="17sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/error_box"
        android:padding="16dp"
        android:textColor="@color/down"
        android:textSize="16sp"
        android:visibility="gone"
        tools:text="@string/error_symbol"
        tools:visibility="visible" />

    <!-- The stock, hidden until the first price arrives -->
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="vertical"
        android:visibility="invisible"
        tools:visibility="visible">

        <TextView
            android:id="@+id/textCompany"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Apple Inc" />

        <TextView
            android:id="@+id/textDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            tools:text="AAPL · NASDAQ" />

        <TextView
            android:id="@+id/textPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="56sp"
            android:textStyle="bold"
            tools:text="$227.48" />

        <TextView
            android:id="@+id/textChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="▲ $1.92 (0.85%)"
            tools:textColor="@color/up" />

        <!-- Four small tiles in a 2 × 2 grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:columnCount="2">

            <LinearLayout style="@style/Tile">
                <TextView style="@style/TileLabel" android:text="@string/open" />
                <TextView android:id="@+id/textOpen" style="@style/TileValue" tools:text="$225.91" />
            </LinearLayout>

            <LinearLayout style="@style/Tile">
                <TextView style="@style/TileLabel" android:text="@string/previous_close" />
                <TextView android:id="@+id/textPreviousClose" style="@style/TileValue" tools:text="$225.56" />
            </LinearLayout>

            <LinearLayout style="@style/Tile">
                <TextView style="@style/TileLabel" android:text="@string/high" />
                <TextView android:id="@+id/textHigh" style="@style/TileValue" tools:text="$228.10" />
            </LinearLayout>

            <LinearLayout style="@style/Tile">
                <TextView style="@style/TileLabel" android:text="@string/low" />
                <TextView android:id="@+id/textLow" style="@style/TileValue" tools:text="$225.30" />
            </LinearLayout>
        </GridLayout>

        <TextView
            android:id="@+id/textUpdated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            tools:text="Updated 14:05 · refreshes every 15 seconds" />
    </LinearLayout>
</LinearLayout>
